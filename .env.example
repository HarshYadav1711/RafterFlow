# Fixed reference time for reproducible business logic (must be timezone-aware).
# Do not rely on the host system clock for agent decisions.
REFERENCE_NOW=2026-10-11T10:00:00+10:00

# SQLite by default; path is relative to the process working directory.
DATABASE_URL=sqlite:///./rafterflow.db

# Admin API key for later protected endpoints (GET /leads). Change before any real use.
ADMIN_API_KEY=change-me

# LLM provider settings (used in later phases; leave blank until configured).
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Mock on-call notification log (R5). Relative paths are from the process cwd.
NOTIFICATIONS_LOG_PATH=notifications.log

# R10 enquiry audit JSONL (one object per completed /enquiries). Not the same as notifications.log.
AUDIT_LOG_PATH=enquiry_audit.jsonl
