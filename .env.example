# Fixed reference time for reproducible business logic (must be timezone-aware).
# Do not rely on the host system clock for agent decisions.
REFERENCE_NOW=2026-10-11T10:00:00+10:00

# SQLite URL. Local default is a file in the process cwd.
# Docker Compose overrides this to sqlite:////data/rafterflow.db on the named volume.
DATABASE_URL=sqlite:///./rafterflow.db

# Admin API key for GET /leads (header X-API-Key). Change before any shared use.
ADMIN_API_KEY=change-me

# OpenAI-compatible LLM (required for live /enquiries and Appendix F eval).
# Examples: Groq, OpenAI, local Ollama-compatible gateway.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# R5 mock on-call notification log (separate from R10 audit).
# Docker Compose overrides to /data/notifications.log
NOTIFICATIONS_LOG_PATH=notifications.log

# R10 enquiry audit JSONL (one object per completed /enquiries).
# Docker Compose overrides to /data/enquiry_audit.jsonl
AUDIT_LOG_PATH=enquiry_audit.jsonl

# Appendix F eval runner target (python run_eval.py). Not used by the API itself.
EVAL_BASE_URL=http://127.0.0.1:8000
